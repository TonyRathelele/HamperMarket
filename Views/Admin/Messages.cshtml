@model List<MessageLog>
@{
    ViewData["Title"] = "Simulated Messages";
}
<div class="container mt-4">
    <h2 class="section-title">✉️ Simulated Email &amp; SMS Log</h2>
    <p class="text-muted">No real emails or SMS messages are sent in this demo &mdash; every notification the platform "sends" is logged here instead.</p>

    @if (!Model.Any())
    {
        <p class="text-muted">No messages sent yet.</p>
    }
    else
    {
        <div class="accordion" id="msgAccordion">
            @{ var i = 0; }
            @foreach (var m in Model)
            {
                i++;
                <div class="accordion-item mb-2 card-hamper">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#msg@(i)">
                            <span class="me-2">@(m.Channel == MessageChannel.Email ? "📧" : "📱")</span>
                            <strong class="me-2">@m.Subject</strong>
                            <span class="text-muted small">to @m.To &middot; @m.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </button>
                    </h2>
                    <div id="msg@(i)" class="accordion-collapse collapse" data-bs-parent="#msgAccordion">
                        <div class="accordion-body">
                            <pre style="white-space: pre-wrap; font-family: inherit;">@m.Body</pre>
                            @if (!string.IsNullOrEmpty(m.RelatedOrderId))
                            {
                                <p class="small text-muted mb-0">Related order: @m.RelatedOrderId</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
