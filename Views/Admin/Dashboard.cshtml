@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="container mt-4">
    <h2 class="section-title">🛠️ Admin Dashboard</h2>

    <div class="row g-3 mb-4">
        <div class="col-md-2 col-6">
            <div class="stat-card"><div class="stat-value">@Model.TotalSellers</div><div class="text-muted small">Sellers</div></div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card"><div class="stat-value">@Model.PendingSellers</div><div class="text-muted small">Pending Sellers</div></div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card"><div class="stat-value">@Model.TotalProducts</div><div class="text-muted small">Products</div></div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card"><div class="stat-value">@Model.PendingProducts</div><div class="text-muted small">Pending Products</div></div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card"><div class="stat-value">@Model.TotalOrders</div><div class="text-muted small">Orders</div></div>
        </div>
        <div class="col-md-2 col-6">
            <div class="stat-card"><div class="stat-value">R@(Model.TotalRevenue.ToString("N0"))</div><div class="text-muted small">Revenue</div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Sellers" class="btn btn-outline-hamper w-100 py-3">👥 Manage Sellers</a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-hamper w-100 py-3">🧺 Manage Products</a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-hamper w-100 py-3">📦 All Orders</a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Admin" asp-action="Messages" class="btn btn-outline-hamper w-100 py-3">✉️ Simulated Messages</a>
        </div>
    </div>

    <h5 class="mb-3">Recent Orders</h5>
    @if (!Model.RecentOrders.Any())
    {
        <p class="text-muted">No orders yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hamper">
                <thead><tr><th>Order</th><th>Buyer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var o in Model.RecentOrders)
                    {
                        <tr>
                            <td>@o.Id</td>
                            <td>@o.BuyerName</td>
                            <td>R@(o.Total.ToString("N2"))</td>
                            <td><span class="status-pill status-@(o.Status.ToString().ToLower())">@o.Status</span></td>
                            <td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
