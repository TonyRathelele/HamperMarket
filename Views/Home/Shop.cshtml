@model ShopViewModel
@{
    ViewData["Title"] = "Shop Hampers";
}

<div class="container mt-4">
    <h2 class="section-title">Shop Hampers</h2>

    <form method="get" asp-action="Shop" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" name="q" value="@Model.Query" class="form-control" placeholder="Search hampers, e.g. 'vegan' or 'braai'" />
        </div>
        <div class="col-md-3">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(c == Model.SelectedCategory)">@c</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="label" class="form-select">
                <option value="">All Labels</option>
                @foreach (var l in Model.Labels)
                {
                    <option value="@l" selected="@(l == Model.SelectedLabel)">@l</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-hamper w-100">Go</button>
        </div>
    </form>

    <p class="text-muted">@Model.Products.Count hamper(s) found</p>

    <div class="row g-4">
        @foreach (var p in Model.Products)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card card-hamper h-100">
                    <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@p.Id" class="text-decoration-none text-reset">
                        <div class="emoji-thumb">
                            @if (p.ImageEmoji.StartsWith("http"))
                            {
                                <img src="@p.ImageEmoji" alt="@p.Name" />
                            }
                            else
                            {
                                @p.ImageEmoji
                            }
                            </div>
                    </a>
                    <div class="card-body d-flex flex-column">
                        <a asp-controller="Home" asp-action="ProductDetails" asp-route-id="@p.Id" class="text-decoration-none text-reset">
                            <h6 class="mb-1">@p.Name</h6>
                        </a>
                        <p class="small text-muted mb-1">by @Model.SellerNames.GetValueOrDefault(p.Id, "Seller")</p>
                        <div class="mb-2">
                            @foreach (var l in p.Labels.Take(2))
                            {
                                <span class="badge badge-label me-1">@l</span>
                            }
                        </div>
                        <div class="price-tag mb-2">R@(p.Price.ToString("N2"))</div>
                        <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button type="submit" class="btn btn-hamper btn-sm w-100" @(p.Stock <= 0 ? "disabled" : "")>
                                @(p.Stock <= 0 ? "Out of stock" : "Add to Cart")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Products.Any())
    {
        <p class="text-muted mt-4">No hampers matched your search. Try a different keyword or filter.</p>
    }
</div>
