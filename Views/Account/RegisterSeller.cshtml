@model SellerRegisterViewModel
@{
    ViewData["Title"] = "Become a Seller";
}
<div class="container mt-5" style="max-width: 600px;">
    <h2 class="section-title">Sell Your Hampers on HamperMarket</h2>
    <p class="text-muted">Registering opens a review request with our admin team. Once approved, you can list and label your own hampers.</p>

    <div class="card card-hamper p-4">
        <form asp-controller="Account" asp-action="RegisterSeller" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label" asp-for="BusinessName"></label>
                <input asp-for="BusinessName" class="form-control" placeholder="e.g. Karoo Gift Co." />
                <span asp-validation-for="BusinessName" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control" placeholder="082 555 0101" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Password"></label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Bio"></label>
                <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Tell buyers what makes your hampers special..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="LogoEmoji"></label>
                <input asp-for="LogoEmoji" class="form-control" style="width: 100px;" />
                <div class="form-text">A single emoji used as your shop icon (e.g. 🧺 🌸 🎁).</div>
            </div>

            <button type="submit" class="btn btn-hamper w-100">Submit Application</button>
        </form>
    </div>

    <p class="mt-3">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
