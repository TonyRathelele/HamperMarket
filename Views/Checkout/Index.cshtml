@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}
<div class="container mt-4">
    <h2 class="section-title"><span class="step-badge">1</span>Checkout</h2>

    <div class="row">
        <div class="col-lg-7">
            <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" id="checkoutForm">
                @Html.AntiForgeryToken()

                <div class="card card-hamper p-4 mb-4">
                    <h5 class="mb-3">📇 Your Details</h5>
                    <div class="mb-3">
                        <label class="form-label" asp-for="BuyerName">Full Name</label>
                        <input asp-for="BuyerName" class="form-control" />
                        <span asp-validation-for="BuyerName" class="text-danger small"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="BuyerEmail">Email</label>
                            <input asp-for="BuyerEmail" class="form-control" />
                            <span asp-validation-for="BuyerEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="BuyerPhone">Phone</label>
                            <input asp-for="BuyerPhone" class="form-control" placeholder="082 555 0101" />
                            <span asp-validation-for="BuyerPhone" class="text-danger small"></span>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">We'll send your order confirmation to this email &amp; phone (simulated).</p>
                </div>

                <div class="card card-hamper p-4 mb-4">
                    <h5 class="mb-3">📦 Shipping Method</h5>
                    <div class="form-text mb-2">
                        Choose <strong>PAXI</strong> to collect from a PEP store, or <strong>PEP Door-to-Door</strong> for courier delivery to your address.
                    </div>

                    @foreach (var opt in Model.AvailableOptions)
                    {
                        <div class="form-check pickup-point-option mb-2">
                            <input class="form-check-input shipping-option-radio" type="radio" name="ShippingCarrier" id="carrier_@(opt.Carrier)_@(opt.ServiceName.Replace(" ", ""))"
                                   value="@opt.Carrier" data-service="@opt.ServiceName" data-carrier="@opt.Carrier" />
                            <label class="form-check-label w-100" for="carrier_@(opt.Carrier)_@(opt.ServiceName.Replace(" ", ""))">
                                <div class="d-flex justify-content-between">
                                    <span><strong>@opt.ServiceName</strong> &mdash; @opt.Description</span>
                                    <span class="price-tag">R@(opt.Cost.ToString("N2"))</span>
                                </div>
                                <div class="small text-muted">ETA: @opt.EtaText</div>
                            </label>
                            <input type="hidden" class="service-name-value" value="@opt.ServiceName" />
                        </div>
                    }
                    <input type="hidden" asp-for="ShippingServiceName" id="ShippingServiceNameInput" />
                    <span asp-validation-for="ShippingCarrier" class="text-danger small"></span>
                    <span asp-validation-for="ShippingServiceName" class="text-danger small"></span>

                    <div id="paxiPointSection" class="mt-3" style="display:none;">
                        <label class="form-label">Choose a PEP / PAXI collection point</label>
                        <select asp-for="ShippingPointName" class="form-select">
                            <option value="">-- Select a store --</option>
                            @foreach (var pt in Model.AvailablePoints)
                            {
                                <option value="@pt.Name">@pt.Name &mdash; @pt.City (@pt.Address)</option>
                            }
                        </select>
                        <span asp-validation-for="ShippingPointName" class="text-danger small"></span>
                    </div>

                    <div id="deliveryAddressSection" class="mt-3" style="display:none;">
                        <label class="form-label" asp-for="DeliveryAddress"></label>
                        <textarea asp-for="DeliveryAddress" class="form-control" rows="2" placeholder="Street address, suburb, city, postal code"></textarea>
                        <span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-hamper btn-lg w-100">Continue to Payment</button>
            </form>
        </div>

        <div class="col-lg-5">
            <div class="card card-hamper p-4">
                <h5 class="mb-3">Order Summary</h5>
                @foreach (var line in Model.Cart.Lines)
                {
                    <div class="d-flex justify-content-between small mb-1">
                        <span>@line.Quantity &times; @line.Product.Name</span>
                        <span>R@(line.LineTotal.ToString("N2"))</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <strong>R@(Model.Cart.Subtotal.ToString("N2"))</strong>
                </div>
                <p class="small text-muted mt-2 mb-0">Shipping cost is added once you choose a method.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const radios = document.querySelectorAll('.shipping-option-radio');
        const paxiSection = document.getElementById('paxiPointSection');
        const deliverySection = document.getElementById('deliveryAddressSection');
        const serviceInput = document.getElementById('ShippingServiceNameInput');

        radios.forEach(r => {
            r.addEventListener('change', function () {
                serviceInput.value = this.dataset.service;
                if (this.dataset.carrier === 'Paxi') {
                    paxiSection.style.display = 'block';
                    deliverySection.style.display = 'none';
                } else {
                    paxiSection.style.display = 'none';
                    deliverySection.style.display = 'block';
                }
            });
        });
    </script>
}
