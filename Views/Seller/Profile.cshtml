@model User
@{
    ViewData["Title"] = "My Profile";
}
<div class="container mt-4" style="max-width: 600px;">
    <h2 class="section-title">@Model.LogoEmoji My Shop Profile</h2>
    <div class="card card-hamper p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Business Name</dt>
            <dd class="col-sm-8">@Model.DisplayName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Model.Phone</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8"><span class="status-pill status-@(Model.Status.ToString().ToLower())">@Model.Status</span></dd>

            <dt class="col-sm-4">Bio</dt>
            <dd class="col-sm-8">@Model.Bio</dd>

            <dt class="col-sm-4">Member Since</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
        </dl>
    </div>
    <p class="text-muted small mt-2">Profile editing isn't available in this demo build &mdash; contact the admin to update your details.</p>
</div>
