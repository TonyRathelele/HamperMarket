@model ProductFormViewModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Id) ? "Add New Hamper" : "Edit Hamper";
}
<div class="container mt-4" style="max-width: 700px;">
    <h2 class="section-title">@ViewData["Title"]</h2>

    <div class="card card-hamper p-4">
        <form asp-controller="Seller" asp-action="SaveProduct" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Karoo Biltong & Droëwors Box" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="Price">Price (R)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label" asp-for="Stock"></label>
                    <input asp-for="Stock" type="number" class="form-control" />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Product Image URL</label>
                    <input asp-for="ImageEmoji" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                    <div class="form-text">Paste a direct image URL (e.g. from Unsplash).</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Category"></label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Snack Hampers, Spa & Wellness, Seasonal" />
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="LabelsCsv"></label>
                <input asp-for="LabelsCsv" class="form-control" placeholder="Vegan, Gift for Her, Christmas" />
                <div class="form-text">These labels help buyers filter and find your hamper in the shop.</div>
            </div>

            <div class="alert alert-warning small">
                ℹ️ New or edited products are submitted for admin review and will show as <em>Pending Approval</em> until approved.
            </div>

            <button type="submit" class="btn btn-hamper w-100">Save Hamper</button>
            <a asp-controller="Seller" asp-action="Products" class="btn btn-outline-hamper w-100 mt-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
